# Port for `npm start` / `npm run dev`.
PORT=3000
# Open Food Facts asks every app to identify itself: AppName/Version (contact email or URL).
OFF_USER_AGENT="FoodChecker/0.1.0 (you@example.com)"
# ChatGPT app directory submission only: your widget origin, and the domain verification token.
CHATGPT_WIDGET_DOMAIN=
OPENAI_APPS_CHALLENGE=
