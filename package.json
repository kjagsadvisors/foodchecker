{
  "name": "foodchecker",
  "version": "0.1.0",
  "description": "Open-source food label checker for ChatGPT and Claude. Scores packaged food 0-100 from nutrition, additives and processing, using Open Food Facts data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "foodchecker-mcp": "dist/stdio.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/http.ts",
    "start": "node dist/http.js",
    "stdio": "tsx src/stdio.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "dev:host": "esbuild scripts/dev-host/host.ts --bundle --format=iife --platform=browser --outfile=scripts/dev-host/dist/host.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
